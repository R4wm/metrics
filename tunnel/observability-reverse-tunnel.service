[Unit]
Description=Reverse SSH tunnel for Grafana observability UI
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/observability/tunnel.env
ExecStart=/usr/bin/autossh -M 0 -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 127.0.0.1:${VPS_GRAFANA_PORT}:127.0.0.1:${LOCAL_GRAFANA_PORT} ${VPS_USER}@${VPS_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
