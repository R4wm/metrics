      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (status) (rate(nginx_http_requests_total{job=\"nginx_log\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
