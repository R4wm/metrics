      },
      "targets": [
        {
          "expr": "kaneo_application_up{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
