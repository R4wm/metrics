{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Metrics targets",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Host CPU usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by(host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Lowest free disk (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * min by(host) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Host memory used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Kaneo health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "kaneo_application_up{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "title": "Kaneo latest backup",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "kaneo_backup_last_attempt_success{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "Kaneo backup age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "time() - kaneo_backup_last_success_timestamp_seconds{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 13,
      "title": "Kaneo repository free",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "kaneo_backup_repository_free_bytes{host=\"10.0.0.68\"} >= 0",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 14,
      "title": "NAS reachable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "prsm_nas_reachable{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 15,
      "title": "NAS backup mount",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "prsm_nas_mount_up{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 16,
      "title": "NAS RAID status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "prsm_nas_raid_status{host=\"10.0.0.68\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 17,
      "title": "NAS mount free space (client df)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "prsm_nas_mount_avail_bytes{host=\"10.0.0.68\"} and on() (prsm_nas_mount_df_valid{host=\"10.0.0.68\"} == 1) and on() (time() - prsm_nas_check_timestamp_seconds{host=\"10.0.0.68\"} < 180)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "df Avail on the NFS backup mount as seen from baser4wm (filesystem blocks, not backup size). No data when df failed or the export is stale - never a fake 0."
    },
    {
      "id": 18,
      "title": "Backup allocated size (du on NAS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "description": "Allocated bytes under BACKUP_USAGE_PATHS, measured with du -s -B1 on the NAS over SSH every 15 min (disk usage, not apparent size). Gaps mean the scan failed or is stale (>45 min), not that backups shrank.",
      "targets": [
        {
          "expr": "prsm_nas_backup_usage_bytes{host=\"10.0.0.68\"} and on() (prsm_nas_backup_usage_bytes_valid{host=\"10.0.0.68\"} == 1) and on() (time() - prsm_nas_backup_usage_timestamp_seconds{host=\"10.0.0.68\"} < 2700)",
          "legendFormat": "backup allocated",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "NAS array used / size (df on NAS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "description": "df Used and size of NAS_STORAGE_PATH on the NAS over SSH (whole filesystem, all data - not just backups). Gaps mean SSH/df failed, the path was not mounted on the NAS, or the export is stale (>3 min).",
      "targets": [
        {
          "expr": "prsm_nas_storage_used_bytes{host=\"10.0.0.68\"} and on() (prsm_nas_storage_df_valid{host=\"10.0.0.68\"} == 1) and on() (time() - prsm_nas_check_timestamp_seconds{host=\"10.0.0.68\"} < 180)",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "prsm_nas_storage_size_bytes{host=\"10.0.0.68\"} and on() (prsm_nas_storage_df_valid{host=\"10.0.0.68\"} == 1) and on() (time() - prsm_nas_check_timestamp_seconds{host=\"10.0.0.68\"} < 180)",
          "legendFormat": "size",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "platform"
  ],
  "title": "Platform Overview",
  "uid": "platform-overview",
  "version": 4
}
