{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {"id": 1, "title": "Availability", "type": "stat", "targets": [{"expr": "up{job=\"bible_api\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "mappings": [{"type": "value", "options": {"1": {"text": "UP", "color": "green", "index": 0}, "0": {"text": "DOWN", "color": "red", "index": 1}}}]}, "overrides": []}, "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "title": "Request rate", "type": "timeseries", "targets": [{"expr": "sum(rate(bible_api_http_requests_total[5m]))", "legendFormat": "requests", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}},
    {"id": 3, "title": "5xx rate", "type": "timeseries", "targets": [{"expr": "sum(rate(bible_api_http_requests_total{status_class=\"5xx\"}[5m]))", "legendFormat": "5xx", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}},
    {"id": 4, "title": "p95 latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum by(le) (rate(bible_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}},
    {"id": 5, "title": "In-flight requests", "type": "timeseries", "targets": [{"expr": "bible_api_http_in_flight_requests", "legendFormat": "in flight", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 6, "title": "Requests by route", "type": "timeseries", "targets": [{"expr": "sum by(route, status) (rate(bible_api_http_requests_total{status!=\"\"}[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 7, "title": "Requests by status", "type": "timeseries", "targets": [{"expr": "sum by(status) (rate(bible_api_http_requests_total{status!=\"\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}},
    {"id": 8, "title": "Request totals by status (selected range)", "type": "barchart", "description": "Whole-number request count per HTTP status over the dashboard time range. Use this instead of the rate panels when traffic is sparse, since rate() is per-second and decays to zero between requests. increase_pure is a VictoriaMetrics function; it avoids the window-edge extrapolation that makes increase() overcount. Swap back to increase() if this dashboard is ever pointed at upstream Prometheus.", "targets": [{"expr": "round(sum by(status) (increase_pure(bible_api_http_requests_total{status!=\"\"}[$__range])))", "legendFormat": "{{status}}", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}},
    {"id": 9, "title": "Requests per minute by status", "type": "timeseries", "description": "Same data as the per-second status panel, scaled to requests/minute. Easier to read at low traffic volumes where req/s stays well under 1.", "targets": [{"expr": "sum by(status) (rate(bible_api_http_requests_total{status!=\"\"}[5m])) * 60", "legendFormat": "{{status}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqpm", "decimals": 1, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}}
  ],
